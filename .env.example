APP_NAME=OmniSell AI API
ENVIRONMENT=development
AUTH_MODE=api_key
API_KEY=change-me-in-development
ALLOWED_ORIGINS=http://localhost:3000
OIDC_ISSUER=
OIDC_AUDIENCE=omnisell-api
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
OIDC_REQUIRE_MFA=true
OIDC_MFA_AMR_VALUES=mfa,otp
OIDC_REQUIRED_ACR=

DATABASE_URL=postgresql+psycopg://omnisell_app:change-me-app@postgres:5432/omnisell
MIGRATION_DATABASE_URL=postgresql+psycopg://omnisell:change-me-owner@postgres:5432/omnisell
DATABASE_APP_USER=omnisell_app
DATABASE_APP_PASSWORD=change-me-app
AUTO_CREATE_SCHEMA=false
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0
TASK_BACKEND=celery
CELERY_TASK_ALWAYS_EAGER=false
CUSTOMER_CASE_CLUSTER_MINIMUM_SAMPLES=3
CUSTOMER_CASE_CLUSTER_WINDOW_DAYS=7

MODEL_BASE_URL=http://host.docker.internal:11434/v1
MODEL_NAME=qwen2.5:3b
MODEL_API_KEY=not-needed
MODEL_PROVIDER=openai_compatible
MODEL_FALLBACK_ENABLED=false
MODEL_FALLBACK_BASE_URL=https://api.wenrugouai.com/v1
MODEL_FALLBACK_MODEL_NAME=
MODEL_FALLBACK_API_KEY=
MODEL_FALLBACK_PROVIDER=wenrugouai_openai_compatible
MODEL_FALLBACK_TIMEOUT_SECONDS=240
MODEL_FALLBACK_INPUT_COST_PER_MILLION=0
MODEL_FALLBACK_OUTPUT_COST_PER_MILLION=0
MODEL_FALLBACK_PRICING_VERSION=development-fallback-pricing-v1
MODEL_FALLBACK_PRICING_EFFECTIVE_AT=2026-01-01T00:00:00Z
MODEL_FALLBACK_BILL_ON_UNKNOWN_FAILURE=true
MODEL_MAX_TOKENS_PER_TASK=36000
MODEL_MAX_TOOL_CALLS=8
AGENT_TENANT_QUOTA_PER_MINUTE=10
AGENT_TENANT_QUOTA_PER_DAY=200
VISION_BASE_URL=http://host.docker.internal:11434
VISION_MODEL_NAME=llava:7b
VISION_TIMEOUT_SECONDS=180
VISION_MAX_IMAGE_BYTES=8388608

CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=omnisell_customer_kb
MOCK_PLATFORM_URL=http://localhost:8002
OAUTH_CLIENT_ID=omnisell_agent
OAUTH_CLIENT_SECRET=change-me
OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_LWA_REVOKE_URL=https://api.amazon.com/auth/o2/token/revoke
AMAZON_APPLICATION_ID=
AMAZON_REDIRECT_URI=https://your-domain.example/api/channels/amazon/callback
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-na.amazon.com
AMAZON_SELLER_CENTRAL_URL=https://sellercentral.amazon.com
AMAZON_REGION=na
AMAZON_MARKETPLACE_IDS=ATVPDKIKX0DER
AMAZON_WRITES_ENABLED=false
AMAZON_PILOT_READ_ONLY=true
AMAZON_NOTIFICATION_TOKEN=generate-a-long-random-token
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

RATE_LIMIT_PER_MINUTE=60
TEXT_QUEUE_WORKERS=2
VISION_QUEUE_WORKERS=1
AUDIT_LOG_PATH=/app/logs/audit.jsonl
SANDBOX_IMAGE=omnisell-sandbox:1.0.0
SANDBOX_TIMEOUT_SECONDS=30

# OpenTelemetry / LLM observability
OTEL_SERVICE_NAME=omnisell-api
# Example: http://otel-collector:4318 or a Langfuse OTLP endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated key=value pairs, for example Authorization=Basic xxx.
OTEL_EXPORTER_OTLP_HEADERS=
# Prompts/completions may contain customer or Amazon data. Enable only with secured retention controls.
TELEMETRY_CAPTURE_LLM_CONTENT=false

# Bounded advisor model budgets and cost accounting
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_TOKENS_PER_TASK=36000
MODEL_INPUT_COST_PER_MILLION=0
MODEL_OUTPUT_COST_PER_MILLION=0
MODEL_PRICING_VERSION=development-pricing-v1
MODEL_PRICING_EFFECTIVE_AT=2026-01-01T00:00:00Z
MODEL_BILL_ON_UNKNOWN_FAILURE=true
