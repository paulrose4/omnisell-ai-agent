# Local application ports. Change these when a port is already occupied.
LOCAL_FRONTEND_PORT=3000
E2E_API_PORT=8080
E2E_MOCK_CLOUD_PORT=9000
E2E_MOCK_PLATFORM_PORT=8002
E2E_POSTGRES_PORT=55432
E2E_REDIS_PORT=6379

# Local-only credentials. Never reuse these values in shared or cloud environments.
LOCAL_AUTH_SECRET=local-omnisell-auth-secret-change-before-shared-use
LOCAL_OIDC_CLIENT_SECRET=local-oidc-client-secret
E2E_POSTGRES_PASSWORD=local-postgres-password
E2E_DATABASE_APP_PASSWORD=local-app-password
E2E_REDIS_PASSWORD=local-redis-password
E2E_NOTIFICATION_TOKEN=local-notification-token-change-for-shared-machines
E2E_TENANT_ID=local-demo
E2E_OIDC_SUBJECT=local-owner

# Optional external OpenAI-compatible model. Keep blank to use local Ollama defaults.
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_NAME=
LOCAL_MODEL_API_KEY=
LOCAL_MODEL_FALLBACK_ENABLED=false
LOCAL_MODEL_FALLBACK_BASE_URL=https://api.wenrugouai.com/v1
LOCAL_MODEL_FALLBACK_MODEL_NAME=
LOCAL_MODEL_FALLBACK_API_KEY=
LOCAL_MODEL_FALLBACK_PROVIDER=wenrugouai_openai_compatible
LOCAL_MODEL_FALLBACK_TIMEOUT_SECONDS=240
LOCAL_MODEL_FALLBACK_INPUT_COST_PER_MILLION=0
LOCAL_MODEL_FALLBACK_OUTPUT_COST_PER_MILLION=0
LOCAL_MODEL_FALLBACK_PRICING_VERSION=development-fallback-pricing-v1
LOCAL_MODEL_FALLBACK_PRICING_EFFECTIVE_AT=2026-01-01T00:00:00Z
LOCAL_MODEL_FALLBACK_BILL_ON_UNKNOWN_FAILURE=true

# Defaults below are calibrated from the sanitized gpt-5.6-terra staging smoke.
LOCAL_MODEL_MAX_TOKENS_PER_TASK=36000
LOCAL_MODEL_TIMEOUT_SECONDS=240
LOCAL_MODEL_INPUT_COST_PER_MILLION=2.5
LOCAL_MODEL_OUTPUT_COST_PER_MILLION=15
LOCAL_MODEL_PRICING_VERSION=local-provider-pricing-v1
LOCAL_MODEL_PRICING_EFFECTIVE_AT=2026-01-01T00:00:00Z
LOCAL_MODEL_BILL_ON_UNKNOWN_FAILURE=true
LOCAL_AGENT_TENANT_QUOTA_PER_MINUTE=10
LOCAL_AGENT_TENANT_QUOTA_PER_DAY=100
