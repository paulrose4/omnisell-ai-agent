APP_NAME=OmniSell AI API
ENVIRONMENT=production
RELEASE_PROFILE=read_only_pilot
OPS_DOMAIN=ops.company.example
API_DOMAIN=api.company.example

AUTH_MODE=oidc
API_KEY=
ALLOWED_ORIGINS=https://ops.company.example
OIDC_ISSUER=https://identity.company.example
OIDC_AUDIENCE=omnisell-api
OIDC_JWKS_URL=https://identity.company.example/.well-known/jwks.json
OIDC_ALGORITHMS=RS256
OIDC_REQUIRE_MFA=true
OIDC_MFA_AMR_VALUES=mfa,otp
OIDC_REQUIRED_ACR=

POSTGRES_PASSWORD=replace-with-database-owner-password
DATABASE_APP_USER=omnisell_app
DATABASE_APP_PASSWORD=replace-with-application-database-password
DATABASE_URL=postgresql+psycopg://omnisell_app:replace-with-application-database-password@postgres:5432/omnisell
MIGRATION_DATABASE_URL=postgresql+psycopg://omnisell:replace-with-database-owner-password@postgres:5432/omnisell
AUTO_CREATE_SCHEMA=false

REDIS_PASSWORD=replace-with-redis-password
REDIS_URL=redis://:replace-with-redis-password@redis:6379/0
TASK_BACKEND=celery
CELERY_TASK_ALWAYS_EAGER=false

MODEL_PROVIDER=openai_compatible
MODEL_BASE_URL=http://model-gateway.internal:8000/v1
MODEL_NAME=replace-with-approved-model
MODEL_API_KEY=replace-from-secret-manager
MODEL_MAX_TOKENS_PER_TASK=36000
MODEL_MAX_TOOL_CALLS=8
MODEL_TIMEOUT_SECONDS=240
MODEL_INPUT_COST_PER_MILLION=1.00
MODEL_OUTPUT_COST_PER_MILLION=2.00
MODEL_PRICING_VERSION=replace-with-approved-pricing-version
MODEL_PRICING_EFFECTIVE_AT=2026-01-01T00:00:00Z
MODEL_BILL_ON_UNKNOWN_FAILURE=true
MODEL_FALLBACK_ENABLED=false
MODEL_FALLBACK_BASE_URL=https://api.wenrugouai.com/v1
MODEL_FALLBACK_MODEL_NAME=replace-with-approved-fallback-model
MODEL_FALLBACK_API_KEY=replace-from-secret-manager
MODEL_FALLBACK_PROVIDER=wenrugouai_openai_compatible
MODEL_FALLBACK_TIMEOUT_SECONDS=240
MODEL_FALLBACK_INPUT_COST_PER_MILLION=1.00
MODEL_FALLBACK_OUTPUT_COST_PER_MILLION=2.00
MODEL_FALLBACK_PRICING_VERSION=replace-with-approved-fallback-pricing-version
MODEL_FALLBACK_PRICING_EFFECTIVE_AT=2026-01-01T00:00:00Z
MODEL_FALLBACK_BILL_ON_UNKNOWN_FAILURE=true
AGENT_TENANT_QUOTA_PER_MINUTE=10
AGENT_TENANT_QUOTA_PER_DAY=200
VISION_BASE_URL=http://vision-gateway.internal:8000
VISION_MODEL_NAME=replace-with-approved-vision-model
VISION_TIMEOUT_SECONDS=180
VISION_MAX_IMAGE_BYTES=8388608

AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_LWA_REVOKE_URL=https://api.amazon.com/auth/o2/token/revoke
AMAZON_APPLICATION_ID=
AMAZON_REDIRECT_URI=https://api.company.example/api/channels/amazon/callback
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-na.amazon.com
AMAZON_SELLER_CENTRAL_URL=https://sellercentral.amazon.com
AMAZON_REGION=na
AMAZON_MARKETPLACE_IDS=ATVPDKIKX0DER
AMAZON_WRITES_ENABLED=false
AMAZON_PILOT_READ_ONLY=true
AMAZON_NOTIFICATION_TOKEN=replace-with-at-least-32-random-characters
SECRET_ENCRYPTION_KEY=replace-with-generated-fernet-key
MOCK_DRILL_ENABLED=false

RATE_LIMIT_PER_MINUTE=60
TEXT_QUEUE_WORKERS=2
VISION_QUEUE_WORKERS=1
AUDIT_LOG_PATH=/app/logs/audit.jsonl
SANDBOX_IMAGE=omnisell-sandbox:1.0.0
SANDBOX_TIMEOUT_SECONDS=30

OTEL_SERVICE_NAME=omnisell-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://observability:4318
OTEL_EXPORTER_OTLP_HEADERS=
TELEMETRY_CAPTURE_LLM_CONTENT=false
AGENT_BUDGET_PROFILES={"operations_brief_analysis":{"max_prompt_tokens":9000,"max_completion_tokens":5000,"max_estimated_cost":"0.12","max_evidence_items":14,"max_evidence_chars":6000,"max_total_evidence_chars":24000,"max_request_bytes":64000,"timeout_seconds":240},"customer_case_analysis":{"max_prompt_tokens":7000,"max_completion_tokens":5000,"max_estimated_cost":"0.10","max_evidence_items":80,"max_evidence_chars":6000,"max_total_evidence_chars":18000,"max_request_bytes":56000,"timeout_seconds":180},"listing_optimization_analysis":{"max_prompt_tokens":6000,"max_completion_tokens":4000,"max_estimated_cost":"0.08","max_evidence_items":100,"max_evidence_chars":8000,"max_total_evidence_chars":20000,"max_request_bytes":48000,"timeout_seconds":120},"reconciliation_investigation":{"max_prompt_tokens":8000,"max_completion_tokens":5000,"max_estimated_cost":"0.11","max_evidence_items":150,"max_evidence_chars":6000,"max_total_evidence_chars":26000,"max_request_bytes":64000,"timeout_seconds":240}}
